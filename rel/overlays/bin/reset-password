#!/bin/sh
set -eu

if [ $# -ne 1 ]; then
  echo "Usage: $0 <username>" >&2
  exit 1
fi

cd -P -- "$(dirname -- "$0")"
# The username is passed as environment variable to avoid quoting issues.
RESET_PASSWORD_USERNAME="$1" exec ./ondu eval \
  'Ondu.Release.reset_password(System.fetch_env!("RESET_PASSWORD_USERNAME"))'
