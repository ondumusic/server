    "culori": "^4.0.2",
    "fractional-indexing": "^4.0.0",
    "i18next": "^26.4.3",
    "phoenix": "^1.8.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-resizable-panels": "^4.14.4",
    "vite": "^8.3.4"
