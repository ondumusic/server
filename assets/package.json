    "culori": "^4.0.2",
    "i18next": "^25.7.3",
    "phoenix": "^1.8.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.1",
    "react-resizable-panels": "^4.2.1",
    "react-router": "^7.11.0"
