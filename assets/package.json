    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/phoenix": "^1.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "fishery": "^2.4.0",
    "i18next-cli": "^1.75.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.44",
