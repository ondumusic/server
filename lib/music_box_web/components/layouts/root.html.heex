<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: dark)" />
    <title>MusicBox</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer type="module" phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-accent-50 transition-colors overflow-hidden">
    {@inner_content}

    <script :if={assigns[:hydrate]} type="text/javascript">
      window.hydrateReact = <%= raw JSON.encode!(@hydrate) %>;
    </script>
  </body>
</html>
