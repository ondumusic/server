<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ondu</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script>
      (function() {
        const userSetting = localStorage.getItem("theme") || "auto";
        const theme = userSetting === "auto"
          ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
          : userSetting;
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <script defer type="module" phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-page-bg overflow-hidden">
    {@inner_content}

    <script :if={assigns[:hydrate]} type="text/javascript">
      window.hydrateReact = <%= raw JSON.encode!(@hydrate) %>;
    </script>
  </body>
</html>
